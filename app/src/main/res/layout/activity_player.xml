<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <TextView
            android:id="@+id/roleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/badge_pill"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Mafia.Body"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:textColor="@color/gold"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:id="@+id/choicesLayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Role reveal overlay: the "card" handed to the player instead of plain text -->
    <FrameLayout
        android:id="@+id/roleRevealOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/roleCardPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="28dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:elevation="12dp">

            <TextView
                android:id="@+id/roleEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="72sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/roleTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/roleSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/roleTaglineText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/enterTownButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the Town"
                style="@style/Mafia.Button.Gold"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
